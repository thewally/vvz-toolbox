VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Root van de Quarkus-server (zonder /api), voor knvb-nieuws, image-proxy en team-ical (optioneel:
# zonder deze variabele wordt VITE_SPORTLINK_PROXY_URL gebruikt als die op /api/sportlink eindigt)
VITE_API_URL=https://sportlink-mcp-server.onrender.com
VITE_SPORTLINK_CLIENT_ID=jouw_client_id_hier
VITE_SPORTLINK_CLUB_RELATIECODE=jouw_club_relatiecode_hier

# Aantal dagen vooruit dat activiteiten uit SportLink worden getoond (optioneel, standaard en minimum 100)
VITE_ACTIVITEITEN_DAGEN_VOORUIT=100

# Auth0-login (optioneel; leeg of supabase = Supabase-login)
VITE_AUTH_PROVIDER=
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
VITE_AUTH0_CONNECTION=
